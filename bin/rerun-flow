#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
HOST="127.0.0.1"
PORT="4200"

cleanup() {
  if [ -n "${SERVER_PID:-}" ]; then
    kill "$SERVER_PID" 2>/dev/null || true
    wait "$SERVER_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

# Kill any existing process on the port
lsof -ti ":$PORT" 2>/dev/null | xargs -r kill 2>/dev/null || true
sleep 1

uv run prefect server start --host "$HOST" &> /tmp/prefect-server.log &
SERVER_PID=$!

# Wait for server to be ready
for i in $(seq 1 15); do
  if lsof -i ":$PORT" &>/dev/null; then
    break
  fi
  sleep 1
done

if ! lsof -i ":$PORT" &>/dev/null; then
  echo "Error: Prefect server did not start within 15s" >&2
  exit 1
fi

cd "$SCRIPT_DIR"
PREFECT_API_URL="http://$HOST:$PORT/api" uv run python main.py
