#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
SQLITE3="/opt/homebrew/opt/sqlite/bin/sqlite3"
DB="$SCRIPT_DIR/etl/artifacts/listening.db"

if [ "${1:-}" = "--db" ]; then
  DB="$2"
  shift 2
fi

if [ ! -f "$DB" ]; then
  echo "Error: database not found at $DB" >&2
  exit 1
fi

LOADABLE=$(uv run python -c "import sqlite_vec; print(sqlite_vec.loadable_path())")

exec "$SQLITE3" -header -cmd ".load $LOADABLE" -cmd ".mode column" "$DB" "$@"
